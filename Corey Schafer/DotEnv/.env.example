# --- Best Practices for .env Files ---

# 1. Use UPPER_CASE for variable names:
#    It is the standard convention for environment variables to distinguish them from local variables.
# 2. Avoid Inline Comments (e.g., key=value # comment):
#    Some parsers might include the "#" and the text following it as part of the value.
#    It's safer to put comments on the line above the variable.
# 3. Use Quotes for values with spaces or special characters:
#    Double quotes (") are standard, but single quotes (') can be used for literal strings.

# API_KEY should not have a comment on the same line to avoid parsing issues.
API_KEY=ABCDEF12345
# This key is used to authenticate with the external service provider.

# Use double quotes if the value contains spaces (like "Corey Schafer").
USER_NAME="Corey Schafer"

# Multi-line strings or special characters should be enclosed in single or double quotes.
ADDRESS_1='123 Fake Street
My Town NY'

# Using \n inside quotes is a common way to handle newlines for specific fields.
ADDRESS_2='456 Wrong Street\nYour City LA'

# Variable Interpolation:
# Note: ${USER_NAME} works in many libraries (like python-dotenv), but
# ensure your specific library supports this feature before relying on it.
EMAIL=${USER_NAME}@email.com